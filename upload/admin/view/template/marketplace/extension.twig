{{ header }}{{ column_left }}
<style>
#extension .ccp-extension-table thead { border-top: 3px solid #0057d9; }
#extension .ccp-extension-table thead td { background: #f8fbff; border-right: 1px solid #d9e1ed; vertical-align: middle; }
#extension .ccp-extension-table .ccp-extension-sort { border: 0; background: transparent; color: #1457a7; padding: 4px 2px; font: inherit; font-weight: 600; text-align: left; cursor: pointer; white-space: nowrap; }
#extension .ccp-extension-table .ccp-extension-sort:hover,#extension .ccp-extension-table .ccp-extension-sort:focus { color: #00449f; text-decoration: underline; }
#extension .ccp-extension-table .ccp-extension-sort i { margin-left: 4px; opacity: .75; }
#extension .ccp-extension-table .ccp-extension-main td { vertical-align: middle; }
#extension .ccp-extension-table .ccp-extension-child td { background: #f7f9fc; }
#extension .ccp-extension-table .ccp-extension-main td:last-child { white-space: nowrap; }
html.ccp-admin-dark #extension .ccp-extension-table thead td { background: #1d2936; border-right-color: #384757; }
html.ccp-admin-dark #extension .ccp-extension-table .ccp-extension-sort { color: #9fcaff; }
html.ccp-admin-dark #extension .ccp-extension-table .ccp-extension-child td { background: #1b2632; }
html.ccp-admin-dark #extension .ccp-extension-table .text-muted { color: #a1b0c0; }

/* Stable column geometry for 6/7/8-column extension lists, including mobile. */
#extension { min-width: 0; max-width: 100%; }
#extension fieldset { min-width: 0; max-width: 100%; }
#extension .table-responsive { min-width: 0; width: 100%; max-width: 100%; overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch; }
#extension .ccp-extension-table { width: 100%; min-width: 1100px; table-layout: fixed; margin-bottom: 0; }
#extension .ccp-extension-cols-7 { min-width: 1200px; }
#extension .ccp-extension-cols-8 { min-width: 1320px; }
#extension .ccp-extension-table thead th { background: #f8fbff; border-right: 1px solid #d9e1ed; vertical-align: middle; font-weight: 600; padding: 9px 10px; white-space: normal; overflow: hidden; }
#extension .ccp-extension-table thead th:last-child { text-align: right; }
#extension .ccp-extension-table thead th .ccp-extension-sort { display: inline-flex; align-items: center; justify-content: flex-start; gap: 5px; width: 100%; min-width: 0; white-space: normal; text-align: left; line-height: 1.35; }
#extension .ccp-extension-table .ccp-extension-sort-label { display: inline; flex: 0 1 auto; }
#extension .ccp-extension-table .ccp-extension-sort i { margin-left: 0; flex: 0 0 auto; }
#extension .ccp-extension-table tbody td { vertical-align: middle; overflow: hidden; text-overflow: ellipsis; }
#extension .ccp-extension-table tbody td:first-child { overflow-wrap: anywhere; }
#extension .ccp-extension-table tbody .ccp-extension-date { white-space: nowrap; font-variant-numeric: tabular-nums; }
#extension .ccp-extension-table tbody td:last-child { white-space: nowrap; text-align: right; overflow: visible; }
#extension .ccp-extension-table tbody td:last-child .btn { margin: 0 1px; }
#extension .ccp-extension-cols-6 th:nth-child(1) { width: 39%; }
#extension .ccp-extension-cols-6 th:nth-child(2) { width: 12%; }
#extension .ccp-extension-cols-6 th:nth-child(3) { width: 13%; }
#extension .ccp-extension-cols-6 th:nth-child(4) { width: 13%; }
#extension .ccp-extension-cols-6 th:nth-child(5) { width: 13%; }
#extension .ccp-extension-cols-6 th:nth-child(6) { width: 10%; }
#extension .ccp-extension-cols-7 th:nth-child(1) { width: 33%; }
#extension .ccp-extension-cols-7 th:nth-child(2) { width: 12%; }
#extension .ccp-extension-cols-7 th:nth-child(3) { width: 8%; }
#extension .ccp-extension-cols-7 th:nth-child(4) { width: 12%; }
#extension .ccp-extension-cols-7 th:nth-child(5) { width: 13%; }
#extension .ccp-extension-cols-7 th:nth-child(6) { width: 13%; }
#extension .ccp-extension-cols-7 th:nth-child(7) { width: 9%; }
#extension .ccp-extension-cols-8 th:nth-child(1) { width: 29%; }
#extension .ccp-extension-cols-8 th:nth-child(2) { width: 8%; }
#extension .ccp-extension-cols-8 th:nth-child(3) { width: 11%; }
#extension .ccp-extension-cols-8 th:nth-child(4) { width: 7%; }
#extension .ccp-extension-cols-8 th:nth-child(5) { width: 12%; }
#extension .ccp-extension-cols-8 th:nth-child(6) { width: 12%; }
#extension .ccp-extension-cols-8 th:nth-child(7) { width: 12%; }
#extension .ccp-extension-cols-8 th:nth-child(8) { width: 9%; }
html.ccp-admin-dark #extension .ccp-extension-table thead th { background: #1d2936; border-right-color: #384757; }
</style>
<script src="view/javascript/codecart-extension-sort.js?v=3.0.6.0-226"></script>
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-puzzle-piece"></i> {{ text_list }}</h3>
      </div>
      <div class="panel-body">
        <fieldset>
          <legend>{{ text_type }}</legend>
          <div class="well">
            <div class="input-group">
              <select name="type" class="form-control">
                {% for category in categories %}
                {% if type == category.code %}
                <option value="{{ category.href }}" selected="selected">{{ category.text }}</option>
                {% else %}
                <option value="{{ category.href }}">{{ category.text }}</option>
                {% endif %}
                {% endfor %}
              </select>
              <span class="input-group-addon"><i class="fa fa-filter"></i> {{ text_filter }}</span>
            </div>
          </div>
        </fieldset>
        <div id="extension"></div>
      </div>
    </div>
  </div>
  {% if categories %}
  <script type="text/javascript"><!--
$('select[name="type"]').on('change', function() {
	$.ajax({
		url: $('select[name="type"]').val(),
		dataType: 'html',
		beforeSend: function() {
			$('.fa-filter').addClass('fa-circle-o-notch fa-spin');
			$('.fa-filter').removeClass('fa-filter');
			$('select[name=\'type\']').prop('disabled', true);
		},
		complete: function() {
			$('.fa-circle-o-notch').addClass('fa-filter');
			$('.fa-circle-o-notch').removeClass('fa-circle-o-notch fa-spin');
			$('select[name=\'type\']').prop('disabled', false);
		},
		success: function(html) {
			$('#extension').html(html);
            if (window.CodeCartExtensionSort) { window.CodeCartExtensionSort.apply(); }
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

$('select[name="type"]').trigger('change');

$('#extension').on('click', '.btn-success', function(e) {
	e.preventDefault();
	
	var element = this;

	$.ajax({
		url: $(element).attr('href'),
		dataType: 'html',
		beforeSend: function() {
			$(element).button('loading');
		},
		complete: function() {
			$(element).button('reset');
		},
		success: function(html) {
			$('#extension').html(html);
            if (window.CodeCartExtensionSort) { window.CodeCartExtensionSort.apply(); }
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

$('#extension').on('click', '.btn-danger, .btn-warning', function(e) {
	e.preventDefault();
	
	if (confirm('{{ text_confirm }}')) {
		var element = this;
	
		$.ajax({
			url: $(element).attr('href'),
			dataType: 'html',
			beforeSend: function() {
				$(element).button('loading');
			},
			complete: function() {
				$(element).button('reset');
			},
			success: function(html) {
				// refresh menu and extension list
				$.ajax({
					url: 'index.php?route=marketplace/extension/refreshMenu&user_token={{ user_token }}',
					dataType: 'html',
					success: function(html) {
						if (html) {
							$('#column-left').replaceWith(html);
						}
					},
					complete: function() {
						$('select[name="type"]').trigger('change');
					},
					error: function(xhr, ajaxOptions, thrownError) {
						alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
					}
				});
			},
			error: function(xhr, ajaxOptions, thrownError) {
				alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
			}
		});
	}
});
//--></script>
  {% endif %}
</div>
{{ footer }} 